// Prisma schema for PromptLab (Postgres/Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Recommended when using Neon "pooler" URL in DATABASE_URL:
  // set DIRECT_URL to the NON-pooler connection string
  directUrl = env("DIRECT_URL")
}

model AccessGrant {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AccessSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  deviceId  String
  ip        String?
  ua        String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum FitMode {
  COVER
  CONTAIN
}

model PromptItem {
  id       String @id @default(cuid())
  slug     String @unique

  category String
  title    String
  prompt   String
  imageUrl String

  focusX Float @default(50)
  focusY Float @default(50)

  // ✅ No banco já existe "isPublished".
  // ✅ No código a gente usa "isActive".
  isActive Boolean @default(true) @map("isPublished")

  // ✅ ORDEM MANUAL (menor = primeiro)
  sortOrder Int @default(0)

  // ✅ AUTO ENQUADRAR: COVER (Netflix) ou CONTAIN (mostrar tudo)
  fitMode FitMode @default(COVER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}