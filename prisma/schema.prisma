// Prisma schema for PromptLab (Postgres/Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Recommended when using Neon "pooler" URL in DATABASE_URL:
  // set DIRECT_URL to the NON-pooler connection string
  directUrl = env("DIRECT_URL")
}

model AccessGrant {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AccessSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  deviceId  String
  ip        String?
  ua        String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PromptItem {
  id       String @id @default(cuid())
  slug     String @unique

  category String
  title    String
  prompt   String
  imageUrl String

  focusX Float @default(50)
  focusY Float @default(50)

  // ✅ No banco já existe "isPublished".
  // ✅ No código a gente usa "isActive".
  // Isso mapeia SEM quebrar nada.
  isActive Boolean @default(true) @map("isPublished")

  // ✅ ORDEM MANUAL (menor = primeiro)
  sortOrder Int @default(0)

  // ✅ Ajuste de enquadramento do card:
  // "cover" = preenche o card (pode cortar)
  // "contain" = mostra a imagem inteira (pode ter bordas)
  // (String propositalmente, pra evitar dor com enum/migrations já tentadas.)
  fitMode String @default("cover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
