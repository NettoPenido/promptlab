// Prisma schema for PromptLab (Postgres/Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AccessGrant {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AccessSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  deviceId  String
  ip        String?
  ua        String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PromptItem {
  id       String @id @default(cuid())
  slug     String @unique

  category String
  title    String
  prompt   String
  imageUrl String

  focusX Float @default(50)
  focusY Float @default(50)

  // mapeia pra coluna existente no Postgres: isPublished
  isActive Boolean @default(true) @map("isPublished")

  // ordem manual (menor = primeiro)
  sortOrder Int @default(0)

  // ✅ NOVO: modo de enquadramento (sem enum pra evitar dor)
  // valores esperados: "cover" | "contain"
  fitMode String @default("cover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}