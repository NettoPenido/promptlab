# Database (SQLite local)
DATABASE_URL="file:./dev.db"

# Used to sign access cookies (generate a long random string)
JWT_SECRET="CHANGE_ME_TO_RANDOM_64_CHARS"

# Hotmart Webhook token (configure the same token in Hotmart Webhook settings)
HOTMART_HOTTOK="CHANGE_ME_TO_YOUR_HOTTOK"

# Optional
NODE_ENV="development"
